{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "viewer-performance-ep01-common.schema.json",
  "title": "Mirante4D EP-01 common evidence types",
  "$defs": {
    "u8": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "u32": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "u64d": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)(?![\\s\\S])"
    },
    "u128d": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,37}|[1-2][0-9]{38}|3[0-3][0-9]{37}|340[0-1][0-9]{35}|3402[0-7][0-9]{34}|34028[0-1][0-9]{33}|340282[0-2][0-9]{32}|3402823[0-5][0-9]{31}|34028236[0-5][0-9]{30}|340282366[0-8][0-9]{29}|3402823669[0-1][0-9]{28}|340282366920[0-8][0-9]{26}|3402823669209[0-2][0-9]{25}|34028236692093[0-7][0-9]{24}|340282366920938[0-3][0-9]{23}|3402823669209384[0-5][0-9]{22}|34028236692093846[0-2][0-9]{21}|340282366920938463[0-3][0-9]{20}|3402823669209384634[0-5][0-9]{19}|34028236692093846346[0-2][0-9]{18}|340282366920938463463[0-2][0-9]{17}|3402823669209384634633[0-6][0-9]{16}|34028236692093846346337[0-3][0-9]{15}|340282366920938463463374[0-5][0-9]{14}|34028236692093846346337460[0-6][0-9]{12}|340282366920938463463374607[0-3][0-9]{11}|3402823669209384634633746074[0-2][0-9]{10}|340282366920938463463374607430[0-9]{9}|340282366920938463463374607431[0-6][0-9]{8}|3402823669209384634633746074317[0-5][0-9]{7}|34028236692093846346337460743176[0-7][0-9]{6}|340282366920938463463374607431768[0-1][0-9]{5}|34028236692093846346337460743176820[0-9]{4}|340282366920938463463374607431768210[0-9]{3}|340282366920938463463374607431768211[0-3][0-9]{2}|3402823669209384634633746074317682114[0-4][0-9]|34028236692093846346337460743176821145[0-4]|340282366920938463463374607431768211455)(?![\\s\\S])"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "bytes32": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "git_oid": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"
    },
    "base64url_no_padding": {
      "type": "string",
      "maxLength": 5462,
      "pattern": "^[A-Za-z0-9_-]*(?![\\s\\S])"
    },
    "f64bits": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}(?![\\s\\S])",
      "not": {
        "pattern": "^[7f]ff[0-9a-f]{13}(?![\\s\\S])"
      }
    },
    "ascii": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[\\x20-\\x7e]+(?![\\s\\S])"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/(?:\\.{1,2})(?:/|$))[a-z0-9._-]+(?:/[a-z0-9._-]+){0,8}(?![\\s\\S])"
    },
    "json_pointer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?:/(?:[\\x20-\\x2e\\x30-\\x7d]|~[01])*)+(?![\\s\\S])"
    },
    "candidate_edge": {
      "enum": [
        32,
        64
      ]
    },
    "package_role": {
      "enum": [
        "representative_package",
        "supporting_temporal_package"
      ]
    },
    "trace_family": {
      "enum": [
        "arbitrary_plane",
        "four_panel",
        "time_navigation",
        "mip",
        "dvr",
        "iso",
        "analysis",
        "verification"
      ]
    },
    "comparator": {
      "enum": [
        "headroom_lte",
        "direct_lte",
        "exact_eq",
        "zero_eq"
      ]
    },
    "unit": {
      "enum": [
        "bytes",
        "count",
        "nanoseconds",
        "seconds",
        "basis_points",
        "bytes_per_byte",
        "requests_per_brick",
        "attempts_per_brick"
      ]
    },
    "package_id": {
      "type": "string",
      "pattern": "^m4d-package-v1-sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "scientific_content_id": {
      "type": "string",
      "pattern": "^m4d-sc-v1-sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "recipe_id": {
      "type": "string",
      "pattern": "^m4d-recipe-v1-sha256:[0-9a-f]{64}(?![\\s\\S])"
    },
    "tie_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package_role_tag",
        "trace_family_tag",
        "state_ordinal",
        "protocol_sample_ordinal",
        "within_state_observation_ordinal"
      ],
      "properties": {
        "package_role_tag": {
          "$ref": "#/$defs/u8"
        },
        "trace_family_tag": {
          "$ref": "#/$defs/u8"
        },
        "state_ordinal": {
          "$ref": "#/$defs/u64d"
        },
        "protocol_sample_ordinal": {
          "$ref": "#/$defs/u64d"
        },
        "within_state_observation_ordinal": {
          "$ref": "#/$defs/u64d"
        }
      }
    },
    "raw_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_ordinal",
        "gate_id",
        "authority_path",
        "comparator",
        "unit",
        "numerator",
        "denominator",
        "limit",
        "passed",
        "reason_code"
      ],
      "properties": {
        "gate_ordinal": {
          "$ref": "#/$defs/u32"
        },
        "gate_id": {
          "type": "string",
          "pattern": "^EP01-G[0-9]{3}(?![\\s\\S])"
        },
        "authority_path": {
          "$ref": "#/$defs/ascii"
        },
        "comparator": {
          "$ref": "#/$defs/comparator"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "numerator": {
          "$ref": "#/$defs/u128d"
        },
        "denominator": {
          "$ref": "#/$defs/u128d"
        },
        "limit": {
          "$ref": "#/$defs/u128d"
        },
        "passed": {
          "type": "boolean"
        },
        "reason_code": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^EP01-G[0-9]{3}-comparison-failed(?![\\s\\S])"
            }
          ]
        }
      }
    },
    "primitive_source_kind": {
      "enum": [
        "selection_authority",
        "package_validation",
        "build_import_accounting",
        "runtime_gpu"
      ]
    },
    "primitive_source_commitment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind_tag",
        "source_kind",
        "source_artifact_sha256",
        "source_field_path"
      ],
      "properties": {
        "source_kind_tag": {
          "$ref": "#/$defs/u8"
        },
        "source_kind": {
          "$ref": "#/$defs/primitive_source_kind"
        },
        "source_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_field_path": {
          "$ref": "#/$defs/json_pointer"
        }
      }
    },
    "primitive_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_ordinal",
        "gate_id",
        "authority_path",
        "unit",
        "tie_key",
        "numerator",
        "denominator",
        "source_commitments"
      ],
      "properties": {
        "gate_ordinal": {
          "$ref": "#/$defs/u32"
        },
        "gate_id": {
          "type": "string",
          "pattern": "^EP01-G[0-9]{3}(?![\\s\\S])"
        },
        "authority_path": {
          "$ref": "#/$defs/ascii"
        },
        "unit": {
          "$ref": "#/$defs/unit"
        },
        "tie_key": {
          "$ref": "#/$defs/tie_key"
        },
        "numerator": {
          "$ref": "#/$defs/u128d"
        },
        "denominator": {
          "$ref": "#/$defs/u128d"
        },
        "source_commitments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/primitive_source_commitment"
          }
        }
      }
    }
  }
}
