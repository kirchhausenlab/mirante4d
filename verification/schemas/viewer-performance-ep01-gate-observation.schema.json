{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "viewer-performance-ep01-gate-observation.schema.json",
  "title": "Mirante4D EP-01 gate observation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "selection_authority_sha256",
    "candidate_edge",
    "package_set_generation_sha256",
    "successor_executable_sha256",
    "primitive_observations",
    "selected_gate_rows",
    "observations_complete",
    "candidate_pass"
  ],
  "properties": {
    "schema": {
      "const": "mirante4d-viewer-performance-ep01-gate-observation-evidence-1"
    },
    "selection_authority_sha256": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
    },
    "candidate_edge": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/candidate_edge"
    },
    "package_set_generation_sha256": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
    },
    "successor_executable_sha256": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
    },
    "primitive_observations": {
      "type": "array",
      "minItems": 74,
      "maxItems": 262144,
      "items": {
        "$ref": "viewer-performance-ep01-common.schema.json#/$defs/primitive_observation"
      }
    },
    "selected_gate_rows": {
      "type": "array",
      "minItems": 74,
      "maxItems": 74,
      "items": {
        "$ref": "viewer-performance-ep01-common.schema.json#/$defs/raw_gate"
      }
    },
    "observations_complete": {
      "const": true
    },
    "candidate_pass": {
      "type": "boolean"
    }
  }
}
