{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "viewer-performance-ep01-source-inventory.schema.json",
  "title": "Mirante4D EP-01 private source-preservation evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "selection_authority_sha256",
    "qualification_profile_contract_sha256",
    "workload_bundle_sha256",
    "script_bundle_sha256",
    "captures",
    "source_preservation_commitment_sha256",
    "captures_closed"
  ],
  "properties": {
    "schema": {
      "const": "mirante4d-viewer-performance-ep01-source-inventory-evidence-1"
    },
    "selection_authority_sha256": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
    },
    "qualification_profile_contract_sha256": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
    },
    "workload_bundle_sha256": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
    },
    "script_bundle_sha256": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
    },
    "captures": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/capture"
            },
            {
              "properties": {
                "capture_ordinal": { "const": 0 },
                "phase_tag": { "const": 0 },
                "input_ordinal": { "const": 0 },
                "input_role": { "const": "representative_package" }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/capture"
            },
            {
              "properties": {
                "capture_ordinal": { "const": 1 },
                "phase_tag": { "const": 0 },
                "input_ordinal": { "const": 1 },
                "input_role": { "const": "supporting_temporal_package" }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/capture"
            },
            {
              "properties": {
                "capture_ordinal": { "const": 2 },
                "phase_tag": { "const": 0 },
                "input_ordinal": { "const": 2 },
                "input_role": { "const": "import_source" }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/capture"
            },
            {
              "properties": {
                "capture_ordinal": { "const": 3 },
                "phase_tag": { "const": 1 },
                "input_ordinal": { "const": 0 },
                "input_role": { "const": "representative_package" }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/capture"
            },
            {
              "properties": {
                "capture_ordinal": { "const": 4 },
                "phase_tag": { "const": 1 },
                "input_ordinal": { "const": 1 },
                "input_role": { "const": "supporting_temporal_package" }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/capture"
            },
            {
              "properties": {
                "capture_ordinal": { "const": 5 },
                "phase_tag": { "const": 1 },
                "input_ordinal": { "const": 2 },
                "input_role": { "const": "import_source" }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "source_preservation_commitment_sha256": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
    },
    "captures_closed": {
      "const": true
    }
  },
  "$defs": {
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capture_ordinal",
        "phase_tag",
        "input_ordinal",
        "input_role",
        "root_kind",
        "regular_files",
        "source_bytes",
        "content_inventory_sha256",
        "metadata_generation_sha256",
        "manifest_root_sha256",
        "reviewed_source_fingerprint_sha256"
      ],
      "properties": {
        "capture_ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "phase_tag": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "input_ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "input_role": {
          "enum": [
            "representative_package",
            "supporting_temporal_package",
            "import_source"
          ]
        },
        "root_kind": {
          "enum": [
            "regular_file",
            "directory"
          ]
        },
        "regular_files": {
          "allOf": [
            {
              "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
            },
            {
              "not": {
                "const": "0"
              }
            }
          ]
        },
        "source_bytes": {
          "allOf": [
            {
              "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
            },
            {
              "not": {
                "const": "0"
              }
            }
          ]
        },
        "content_inventory_sha256": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
        },
        "metadata_generation_sha256": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
        },
        "manifest_root_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
            }
          ]
        },
        "reviewed_source_fingerprint_sha256": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
            }
          ]
        }
      },
      "oneOf": [
        {
          "properties": {
            "input_ordinal": {
              "const": 0
            },
            "input_role": {
              "const": "representative_package"
            },
            "root_kind": {
              "const": "directory"
            },
            "manifest_root_sha256": {
              "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
            },
            "reviewed_source_fingerprint_sha256": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "input_ordinal": {
              "const": 1
            },
            "input_role": {
              "const": "supporting_temporal_package"
            },
            "root_kind": {
              "const": "directory"
            },
            "manifest_root_sha256": {
              "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
            },
            "reviewed_source_fingerprint_sha256": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "input_ordinal": {
              "const": 2
            },
            "input_role": {
              "const": "import_source"
            },
            "manifest_root_sha256": {
              "type": "null"
            },
            "reviewed_source_fingerprint_sha256": {
              "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
            }
          }
        }
      ]
    }
  }
}
