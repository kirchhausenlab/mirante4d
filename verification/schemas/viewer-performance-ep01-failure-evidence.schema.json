{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "viewer-performance-ep01-failure-evidence.schema.json",
  "title": "Mirante4D EP-01 private failure evidence envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "private_commitment_nonce_256",
    "repository_revision",
    "clean_tree",
    "selection_authority_sha256",
    "stage",
    "candidate_edge",
    "package_role",
    "gate_id",
    "reason_code",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "mirante4d-viewer-performance-ep01-private-failure-evidence-1"
    },
    "private_commitment_nonce_256": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/bytes32"
    },
    "repository_revision": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/git_oid"
    },
    "clean_tree": {
      "type": "boolean"
    },
    "selection_authority_sha256": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
    },
    "stage": {
      "$ref": "#/$defs/failure_stage"
    },
    "candidate_edge": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/candidate_edge"
        }
      ]
    },
    "package_role": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/package_role"
        }
      ]
    },
    "gate_id": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^EP01-G[0-9]{3}(?![\\s\\S])"
        }
      ]
    },
    "reason_code": {
      "$ref": "#/$defs/failure_reason"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/failure_record"
      }
    }
  },
  "$defs": {
    "failure_stage": {
      "enum": [
        "binding",
        "candidate_build",
        "candidate_validation",
        "trace",
        "runtime_gpu",
        "observation",
        "closure",
        "interrupted"
      ]
    },
    "failure_reason": {
      "enum": [
        "binding_invalid",
        "cancelled",
        "interrupted",
        "candidate_execution_failed",
        "candidate_validation_failed",
        "observation_invalid",
        "artifact_incomplete",
        "receipt_closure_failed"
      ]
    },
    "failure_record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_ordinal",
        "record_kind",
        "detail_encoding",
        "detail_bytes",
        "detail_sha256",
        "original_bytes",
        "detail_truncated"
      ],
      "properties": {
        "record_ordinal": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "record_kind": {
          "type": "string",
          "pattern": "^[a-z0-9._-]{1,64}(?![\\s\\S])"
        },
        "detail_encoding": {
          "const": "base64url_no_padding"
        },
        "detail_bytes": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/base64url_no_padding"
        },
        "detail_sha256": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
        },
        "original_bytes": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "detail_truncated": {
          "type": "boolean"
        }
      }
    }
  }
}
