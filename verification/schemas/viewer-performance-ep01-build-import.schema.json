{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "viewer-performance-ep01-build-import.schema.json",
  "title": "Mirante4D EP-01 build and import evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "selection_authority_sha256",
    "candidate_edge",
    "roles",
    "checkpoint_contract",
    "source_unchanged",
    "candidate_complete"
  ],
  "properties": {
    "schema": {
      "const": "mirante4d-viewer-performance-ep01-build-import-evidence-1"
    },
    "selection_authority_sha256": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
    },
    "candidate_edge": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/candidate_edge"
    },
    "roles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/role_evidence"
      }
    },
    "checkpoint_contract": {
      "$ref": "#/$defs/checkpoint_contract"
    },
    "source_unchanged": {
      "const": true
    },
    "candidate_complete": {
      "const": true
    }
  },
  "$defs": {
    "role_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_tag",
        "role",
        "preprocessing_wall_ns",
        "preprocessing_process_cpu_ns",
        "peak_temporary_bytes",
        "peak_accounted_cpu_bytes",
        "peak_process_rss_bytes",
        "peak_decoded_residency_bytes",
        "peak_upload_staging_bytes",
        "peak_open_objects",
        "peak_queued_requests",
        "peak_checkpoint_regular_files",
        "publication_parent_synced",
        "independent_validation_complete"
      ],
      "properties": {
        "role_tag": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u8"
        },
        "role": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/package_role"
        },
        "preprocessing_wall_ns": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "preprocessing_process_cpu_ns": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "peak_temporary_bytes": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "peak_accounted_cpu_bytes": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "peak_process_rss_bytes": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "peak_decoded_residency_bytes": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "peak_upload_staging_bytes": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "peak_open_objects": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "peak_queued_requests": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "peak_checkpoint_regular_files": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "publication_parent_synced": {
          "const": true
        },
        "independent_validation_complete": {
          "const": true
        }
      }
    },
    "checkpoint_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header_bytes",
        "record_bytes",
        "read_window_bytes",
        "resident_read_windows",
        "maximum_resident_bytes",
        "batch_records",
        "maximum_record_window",
        "maximum_batch_payload_bytes",
        "maximum_batch_age_seconds",
        "recovery_vectors_passed",
        "failpoint_vectors_passed"
      ],
      "properties": {
        "header_bytes": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "record_bytes": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "read_window_bytes": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "resident_read_windows": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "maximum_resident_bytes": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "batch_records": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "maximum_record_window": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "maximum_batch_payload_bytes": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "maximum_batch_age_seconds": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "recovery_vectors_passed": {
          "const": true
        },
        "failpoint_vectors_passed": {
          "const": true
        }
      }
    }
  }
}
