        "s0_scalar_bytes": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "index_bytes": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "package_bytes": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "physical_objects": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "compact_inner_record_bytes": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "shard_index_header_bytes": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "maximum_compact_record_bytes": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "maximum_shard_index_bytes": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "maximum_decoded_shard_bytes": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        },
        "maximum_encoded_shard_bytes": {
          "$ref": "viewer-performance-ep01-common.schema.json#/$defs/u64d"
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "science",
        "display",
        "portable_records",
        "manifest",
        "filesystem_closure",
        "identity",
        "pyramid",
        "shards",
        "package_currentness"
      ],
      "properties": {
        "profile": {
          "const": true
        },
        "science": {
          "const": true
        },
        "display": {
          "const": true
        },
        "portable_records": {
          "const": true
        },
        "manifest": {
          "const": true
        },
        "filesystem_closure": {
          "const": true
        },
        "identity": {
          "const": true
        },
        "pyramid": {
          "const": true
        },
        "shards": {
          "const": true
        },
        "package_currentness": {
          "const": true
        }
      }
    }
