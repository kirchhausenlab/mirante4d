    "scientific_content_id",
    "representation_recipe_id",
    "candidate_geometry_sha256",
    "candidate_content_generation_sha256",
    "storage_profile",
    "facts",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "mirante4d-viewer-performance-ep01-package-validation-evidence-1"
    },
    "selection_authority_sha256": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
    },
    "candidate_edge": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/candidate_edge"
    },
    "package_role": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/package_role"
    },
    "package_external_relative_path": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/relative_path"
    },
    "independent_reader_executable_sha256": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
    },
    "package_id": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/package_id"
    },
    "manifest_root_sha256": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
    },
    "scientific_content_id": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/scientific_content_id"
    },
    "representation_recipe_id": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/recipe_id"
    },
    "candidate_geometry_sha256": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
    },
    "candidate_content_generation_sha256": {
      "$ref": "viewer-performance-ep01-common.schema.json#/$defs/sha256"
    },
    "storage_profile": {
      "enum": [
        "m4d-compound-brick-local-b32-1.0",
        "m4d-compound-brick-local-b64-1.0"
      ]
    },
    "facts": {
      "$ref": "#/$defs/facts"
    },
    "checks": {
      "$ref": "#/$defs/checks"
    }
  },
  "$defs": {
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer_count",
        "level_count",
        "brick_count",
        "shard_count",
