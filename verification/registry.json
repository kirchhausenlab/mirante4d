  "test_timeout_overrides": [
    {
      "selector": "package(mirante4d-app) & test(=tests::typed_import_commands_cancel_resume_publish_and_open_without_a_display)",
      "warn_ms": 5000,
      "terminate_ms": 30000,
      "reason": "This display-free product integration performs setup inspection, a deliberately paused cancellation, checkpointed resume, complete package publication, and normal open through the typed application commands. Its measured local execution is about 14 seconds."
    },
    {
      "selector": "package(mirante4d-import-pipeline) & test(=promoted_source_facts_drive_production_inspection_decode_and_publication)",
      "warn_ms": 10000,
      "terminate_ms": 60000,
      "reason": "This conformance case production-inspects all 21 independently produced TIFFs and publishes eight accepted compression/container representatives against independent facts. Its measured local execution is about 28 seconds."
    },
    {
      "selector": "package(mirante4d-import-pipeline) & test(=cancellation_matrix_resumes_to_one_identity_across_every_prepublication_stage)",
      "warn_ms": 20000,
      "terminate_ms": 120000,
      "reason": "This end-to-end matrix cancels and resumes nine distinct prepublication stages, comparing every result with one clean publication while preserving the source. Its measured local execution is about 48 seconds."
    },
    {
      "selector": "package(mirante4d-app) & (test(=tests::import_analyze_save_and_reopen_without_a_global_integrity_audit) | test(=tests::imported_publication_waits_for_project_close_then_installs_without_an_integrity_audit) | test(=tests::failed_project_close_retains_imported_authority_without_an_audit_fallback) | test(=tests::imported_transfer_drift_fails_closed_without_external_open_fallback))",
      "warn_ms": 5000,
      "terminate_ms": 30000,
      "reason": "These product integrations import and publish a real sharded target package before exercising admitted open, project-close retention, drift rejection, or the wider analyze/save/reopen lifecycle. The broad lifecycle case remains routine; the three narrower cases retain this timeout for explicit developer-local execution."
    },
    {
      "selector": "package(mirante4d-project-store) & test(=actor::tests::hosted_durability_tests::exhaustive_hosted_and_process_transition_matrix)",
      "warn_ms": 20000,
      "terminate_ms": 180000,
      "threads_required": "num-test-threads",
      "reason": "The developer-local matrix discovers 424 transition-edge rows, runs 338 missing fail injections, inherits 86 exact rows, compares 120 parked before/after trees, and performs 102 bounded fresh-process kill/reopen/retry cases with eight internal workers. It reserves every Nextest test slot so unrelated tests cannot starve its child processes, and each actor completion is capped at 15 seconds inside its existing 20-second child bound."
    },
    {
      "selector": "package(mirante4d-project-store) & test(=actor::tests::purge_fresh_process_kill_and_retry_matrix)",
      "warn_ms": 5000,
      "terminate_ms": 40000,
      "reason": "The developer-local Purge crash matrix spawns 32 child processes and performs filesystem syncs, so its termination ceiling remains 40 seconds when selected explicitly."
    },
    {
      "selector": "package(mirante4d-import-pipeline) & test(=process_checkpoint_recovery_survives_forced_worker_termination)",
      "warn_ms": 10000,
      "terminate_ms": 60000,
      "reason": "The developer-local import recovery case spawns and forcibly terminates one child after a durable checkpoint, then resumes and compares a fresh control publication."
    }
